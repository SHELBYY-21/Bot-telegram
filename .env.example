TELEGRAM_BOT_TOKEN=

# Optional: restrict who can use the bot (Telegram user IDs, comma/space separated)
ALLOWED_USER_IDS=

# Ledger SQLite path
LEDGER_DB=ce_vault.db

# Auto rates — staff never enter buy rate
BUY_RATE=39.89
SELL_RATE=40.00

# Optional OCR providers (first available wins)
EASYSLIP_TOKEN=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Optional: mount legacy Cursor Cloud Agents commands
ENABLE_CURSOR_AGENTS=false
CURSOR_API_KEY=
DEFAULT_REPOSITORY=https://github.com/your-org/your-repo
DEFAULT_MODEL=
AUTO_CREATE_PR=false
POLL_INTERVAL_SECONDS=30
STATE_FILE=state.json
