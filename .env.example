# CE VAULT — Telegram FinTech Operations Console
TELEGRAM_BOT_TOKEN=

# Optional: restrict operators (Telegram user IDs, comma/space separated)
ALLOWED_USER_IDS=

# SQLite ledger path
LEDGER_DB=data/vault.db

# Optional Vision OCR (OpenAI-compatible). Without this, caption/text parsing is used.
OCR_API_KEY=
# OPENAI_API_KEY=          # accepted as fallback for OCR_API_KEY
OCR_API_BASE=https://api.openai.com/v1
OCR_MODEL=gpt-4o-mini

# Legacy Cursor Cloud Agents client (optional, unused by CE VAULT console)
CURSOR_API_KEY=
CURSOR_API_URL=https://api.cursor.com
