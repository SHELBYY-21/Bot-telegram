# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional: restrict who can use the console (Telegram user IDs, comma/space separated)
ALLOWED_USER_IDS=

# Desk FX defaults (never asked during intake)
BUY_RATE=39.89
SELL_RATE=40.00

# SQLite ledger path
LEDGER_DB=ce_vault.db

# OCR — optional OpenAI Vision; without it, slip caption / text OCR is used
OPENAI_API_KEY=
OCR_MODEL=gpt-4o-mini
OCR_WARN_BELOW=90

# Legacy Cursor Cloud Agents (optional; unused by CE Vault console)
CURSOR_API_KEY=
