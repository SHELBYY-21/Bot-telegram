# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional: restrict who can use the bot (Telegram user IDs, comma/space separated)
ALLOWED_USER_IDS=

# CE VAULT rates (automatic — staff never enters buy rate on a ticket)
DEFAULT_BUY_RATE=39.89
DEFAULT_SELL_RATE=40.00

# Ledger SQLite path
LEDGER_DB=ledger.db

# Optional: OpenAI Vision for slip OCR (falls back to caption heuristics)
OPENAI_API_KEY=
OCR_MODEL=gpt-4o-mini

# --- Legacy Cursor Cloud Agents (optional) ---
CURSOR_API_KEY=
DEFAULT_REPOSITORY=https://github.com/your-org/your-repo
DEFAULT_MODEL=
AUTO_CREATE_PR=false
POLL_INTERVAL_SECONDS=30
