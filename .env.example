# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional: restrict who can use the bot (Telegram user IDs, comma/space separated)
ALLOWED_USER_IDS=

# --- CE VAULT (default mode) ---

# Exchange rates (auto-applied — never asked from user)
DEFAULT_BUY_RATE=39.89
DEFAULT_SELL_RATE=40.00

# OCR confidence warning threshold (%)
OCR_CONFIDENCE_WARN=90

# Optional: external OCR API endpoint (POST multipart image)
OCR_API_URL=

# Data storage
DATA_DIR=data
DB_PATH=data/vault.db

# --- Legacy Cursor Cloud Agents mode (LEGACY_CURSOR_BOT=1) ---

# Cursor API key (Dashboard → Integrations → API Keys)
CURSOR_API_KEY=

# Optional defaults for legacy mode
DEFAULT_REPOSITORY=https://github.com/your-org/your-repo
DEFAULT_MODEL=
AUTO_CREATE_PR=false
POLL_INTERVAL_SECONDS=30
