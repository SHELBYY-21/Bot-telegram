# CE VAULT — Telegram operations console

TELEGRAM_BOT_TOKEN=

# Optional: restrict operators (Telegram user IDs, comma/space separated)
ALLOWED_USER_IDS=

# Automatic rate engine (THB per USDT). Never prompted in-chat.
BUY_RATE=39.89
SELL_RATE=40.00

# Optional Vision OCR (OpenAI-compatible). Without it, text slips still work.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4o-mini
OCR_WARN_BELOW=90

# Storage
LEDGER_DB=data/ledger.db
IMAGES_DIR=data/slips
STATE_FILE=state.json
