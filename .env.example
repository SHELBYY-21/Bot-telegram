# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional: restrict who can use the bot (Telegram user IDs, comma/space separated)
ALLOWED_USER_IDS=

# Ledger database (SQLite)
DATABASE_PATH=vault.db

# Per-chat UI session state (message ids, pending ledger)
STATE_FILE=state.json

# Automatic rates — never prompted from user
DEFAULT_BUY_RATE=39.89
DEFAULT_SELL_RATE=40.00

# OCR: mock | vision
OCR_PROVIDER=mock
GOOGLE_VISION_API_KEY=

# Warn when OCR confidence is below this threshold
LOW_CONFIDENCE_THRESHOLD=90

# Recorded on each ledger entry
STAFF_NAME=Operator

