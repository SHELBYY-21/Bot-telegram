# CE VAULT — Telegram FinTech Operations Console
TELEGRAM_BOT_TOKEN=

# Optional: restrict operators (Telegram user IDs, comma/space separated)
# When empty and Supabase is configured, admins.telegram_user_id is used.
ALLOWED_USER_IDS=

# Ledger backend: auto | sqlite | supabase
# auto → Supabase when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set
LEDGER_BACKEND=auto
LEDGER_DB=data/vault.db

# Supabase (project Bot-telegram / cewntchvtnuyxvekivwk)
SUPABASE_URL=https://cewntchvtnuyxvekivwk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_KEY=   # alias for SUPABASE_SERVICE_ROLE_KEY

# Optional Vision OCR (OpenAI-compatible). Without this, caption/text parsing is used.
OCR_API_KEY=
OCR_API_BASE=https://api.openai.com/v1
OCR_MODEL=gpt-4o-mini

# Legacy Cursor Cloud Agents client (optional)
CURSOR_API_KEY=
CURSOR_API_URL=https://api.cursor.com
