# OCR provider: auto | mock | tesseract
OCR_PROVIDER=auto
OCR_CONFIDENCE_WARN=90
OCR_TESSERACT_LANGS=tha+eng

# Storage
LEDGER_DB=storage/ledger.db
SESSION_FILE=state.json
