# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Cursor API key (Dashboard → Integrations → API Keys)
# Optional — FinTech console works without it; required for /agent commands
CURSOR_API_KEY=

# Optional: restrict who can use the bot (Telegram user IDs, comma/space separated)
ALLOWED_USER_IDS=

# Optional defaults (Cursor agents)
DEFAULT_REPOSITORY=https://github.com/your-org/your-repo
DEFAULT_MODEL=
AUTO_CREATE_PR=false
POLL_INTERVAL_SECONDS=30

# CE VAULT rate board — staff never enters buy rate
SELL_RATE=40.00
RATE_SPREAD=0.11

# Optional OpenAI vision for slip OCR (falls back to caption heuristics)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Storage
LEDGER_DB=data/ledger.db
STATE_FILE=state.json
