# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional: restrict who can use the bot (Telegram user IDs, comma/space separated)
ALLOWED_USER_IDS=

# CE VAULT ledger + rates
LEDGER_DB=ledger.db
DEFAULT_BUY_RATE=39.89
DEFAULT_SELL_RATE=40.00
DEFAULT_BALANCE_USDT=100000

# Optional Vision OCR (OpenAI-compatible). Without it, caption/text OCR is used.
OPENAI_API_KEY=
VISION_MODEL=gpt-4o-mini

# Optional: re-enable legacy Cursor Cloud Agents commands
ENABLE_CURSOR_AGENTS=false
CURSOR_API_KEY=
DEFAULT_REPOSITORY=https://github.com/your-org/your-repo
DEFAULT_MODEL=
AUTO_CREATE_PR=false
POLL_INTERVAL_SECONDS=30
