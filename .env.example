# CE VAULT — Telegram operations console
# Token: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# Supabase (preferred when URL + secret present)
# Keys: https://supabase.com/dashboard/project/cewntchvtnuyxvekivwk/settings/api
SUPABASE_URL=https://cewntchvtnuyxvekivwk.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://cewntchvtnuyxvekivwk.supabase.co/auth/v1/.well-known/jwks.json
# legacy alias (optional): SUPABASE_SERVICE_ROLE_KEY=

# Empty = load allowlist from Supabase admins.telegram_user_id
ALLOWED_USER_IDS=

# auto | supabase | sqlite
LEDGER_BACKEND=auto
LEDGER_DB=data/vault.db
IMAGES_DIR=data/slips
STATE_FILE=state.json

# === Vision OCR ===
# Grok reads Thai bank slips more accurately than the general-purpose models
# and is used automatically when this key is present. Key: https://console.x.ai
GROK_API_KEY=
# Must be a VISION model — a text-only Grok model silently fails on images.
# GROK_MODEL=grok-2-vision-1212

# Any other OpenAI-compatible endpoint. OCR_API_KEY takes precedence over
# GROK_API_KEY; OCR_API_BASE / OCR_MODEL override whichever provider is chosen.
OCR_API_KEY=
# OCR_API_BASE=https://api.openai.com/v1
# OCR_MODEL=gpt-4o-mini
# alias: OPENAI_API_KEY=

# Confidence below this flags the slip for review instead of auto-verifying.
OCR_WARN_BELOW=90

# === Slip storage ===
# Slip images are the evidence behind each ledger row. With SUPABASE_URL and a
# server key set they upload to Supabase Storage; otherwise they land in
# IMAGES_DIR. auto | local | none
SLIP_STORAGE=auto
SUPABASE_BUCKET=slips
